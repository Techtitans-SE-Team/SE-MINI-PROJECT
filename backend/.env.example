DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/doctor_reminder_db
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Set true only for local dev / tests when the SQL scripts were not run
AUTO_CREATE_TABLES=false

# --- Multilingual media ---
MEDIA_DIR=media
AUTO_GENERATE_MEDIA=true
# FFMPEG_PATH=            # optional, bundled ffmpeg is used by default
EXTERNAL_MAX_RETRIES=3
EXTERNAL_BASE_DELAY=1.5
EXTERNAL_MIN_INTERVAL=0.4
EXTERNAL_COOLDOWN_SECONDS=60

# --- Reminders ---
TIMEZONE=Asia/Kolkata
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_SECONDS=60
